# Node
NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=1

# Public base URL of this API (used for links and CORS)
APP_BASE_URL=http://localhost:4000
# Public base URL of the web app (used to build magic links and password-reset links)
WEB_BASE_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (application role; subject to Row-Level Security)
DATABASE_URL=postgresql://zion8_app:change-me@localhost:5432/zion8?schema=public&connection_limit=10
# PostgreSQL (migration/owner role; bypasses RLS)
MIGRATION_DATABASE_URL=postgresql://zion8:change-me@localhost:5432/zion8?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Secrets at rest (base64-encoded 32-byte AES-256 key)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Verification, MFA and passkeys
VERIFICATION_TTL_SECONDS=900
MAGIC_LINK_TTL_SECONDS=900
MFA_CHALLENGE_TTL_SECONDS=300
TOTP_ISSUER=Zion8
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Zion8
WEBAUTHN_ORIGINS=http://localhost:3000

# Federated identity providers (leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Notification delivery (leave blank to use the logging adapter in development)
EMAIL_FROM_ADDRESS=no-reply@zion8.local
RESEND_API_KEY=
SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Observability
LOG_LEVEL=info

# Member AI summaries. Leave USER_LLM_BASE_URL blank to use the built-in
# deterministic provider, which needs no network access and no key.
USER_LLM_BASE_URL=
USER_LLM_API_KEY=
USER_LLM_MODEL=
LLM_SUMMARY_TIMEOUT_MS=20000

# Object storage. Development uses the local filesystem; production swaps in an
# S3-compatible adapter behind the same ObjectStorage port.
STORAGE_DIR=/tmp/zion8-storage

# Transactional outbox. The relay drains queued integration events; in
# development and CI this is an in-process poller, in production a broker
# consumer. Set EVENT_WEBHOOK_URL to also POST each event to an HTTP endpoint.
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
EVENT_WEBHOOK_URL=

# Digital Memory Engine processing worker. Disabled automatically under tests,
# which drive the runner directly.
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_INTERVAL_MS=5000
MEMORY_WORKER_BATCH_SIZE=10

# Optional external capabilities. Leave blank to record the corresponding stage
# as BLOCKED (OCR) or BLOCKED (transcription) instead of silently succeeding.
MEMORY_OCR_ENDPOINT=
MEMORY_STT_ENDPOINT=

# Zion AI. The defaults are a local deterministic embedder and a local
# extractive answerer, so indexing, retrieval and grounded answers work with no
# key. Point the base URLs at an OpenAI-compatible endpoint to opt into an HTTP
# provider for this workspace. The platform never injects its own credentials.
AI_ENABLED=true

AI_EMBEDDING_PROVIDER=deterministic
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=1536

AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=

# Retrieval and grounding. AI_CITATION_MIN_SUPPORT is the share of claims that
# must resolve to a retrieved passage before an answer is presented as fact;
# below it the answer abstains (see docs/adr/0002-grounding-cite-or-refuse.md).
AI_RETRIEVAL_TOP_K=10
AI_RETRIEVAL_CANDIDATES=50
AI_CITATION_MIN_SUPPORT=0.5
AI_QUERY_TIMEOUT_MS=20000

# Minimum distinct prayer requests before an aggregate insight is reported.
AI_INSIGHT_MIN_COHORT=5

# Indexing worker. Disabled automatically under tests.
AI_WORKER_ENABLED=true
AI_WORKER_INTERVAL_MS=5000
AI_WORKER_BATCH_SIZE=10

# Sermon pipeline worker. Disabled automatically under tests, which drive
# the runner directly. Transcription reuses MEMORY_STT_ENDPOINT; when that is
# blank, audio/video sermons settle as PARTIAL instead of inventing a transcript.
SERMON_WORKER_ENABLED=true
SERMON_WORKER_INTERVAL_MS=5000
SERMON_WORKER_BATCH_SIZE=10
