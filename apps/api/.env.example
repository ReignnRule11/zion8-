# Node
NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=1

# Public base URL of this API (used for links and CORS)
APP_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (application role; subject to Row-Level Security)
DATABASE_URL=postgresql://zion8_app:change-me@localhost:5432/zion8?schema=public&connection_limit=10
# PostgreSQL (migration/owner role; bypasses RLS)
MIGRATION_DATABASE_URL=postgresql://zion8:change-me@localhost:5432/zion8?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Observability
LOG_LEVEL=info
