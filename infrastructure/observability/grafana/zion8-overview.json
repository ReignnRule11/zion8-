{
  "title": "Zion8 overview",
  "uid": "zion8-overview",
  "schemaVersion": 39,
  "tags": ["zion8"],
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "API availability",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "avg_over_time(up{job=\"api\"}[30d])" }]
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\"}[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[5m])))"
        }
      ]
    }
  ]
}
